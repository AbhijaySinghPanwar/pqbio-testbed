# Data & models (gitignored per PROJECT_SPEC.md §3 — manifests, results, and
# models/checksums.txt ARE tracked; the weight binaries themselves are not)
data/raw/
data/processed/
# Server runtime state (devices/sessions/nonces/phash/audit). Every one of these is
# created on startup if absent -- app.py's _lifespan mkdirs the data dir and each store's
# constructor runs CREATE TABLE IF NOT EXISTS -- so nothing needs them committed.
#
# They were tracked until 2026-09-06, and it cost a debugging session: the pHash reuse
# index accumulated across every local run, grew the BK-tree enough to slow the
# evidence_reuse stage, and failed the p99 concurrency test with no code change behind it.
# Committed runtime state also means one developer's accepted bundles silently become
# another's "already reused".
data/server_state/
models/*.pt
models/*.onnx
models/*.pth
# InsightFace's own download cache (buffalo_l.zip + extracted *.onnx nested under
# models/insightface/) — the plain `models/*.onnx` pattern above doesn't cross the
# directory boundary, so this needs its own line.
models/insightface/
# Trained detector model dumps (regenerable from scripts/make_injection_corpus.py +
# pqbio.detect.injection's / pqbio.detect.fusion's training paths) — named explicitly
# since checksums.txt is also a models/*.txt file and must stay tracked.
models/injection_gbm.txt
models/morph_smad_gbm.txt
models/morph_dmad_gbm.txt
models/fusion_cascade_lr.json

