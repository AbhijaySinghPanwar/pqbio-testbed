# NOTE: not build-verified — no Docker engine is available in the environment this was
# written in (verified: `docker` is not on PATH at all, not just failing to run). See
# CLAUDE.md "current state". `pqbio/server/app.py` is still a placeholder (Module E), so
# the container will build and the liboqs check below will pass, but
# `uvicorn pqbio.server.app:app` will not yet serve real endpoints.
#
# Once Docker is available, verify with:
#   docker build -f docker/Dockerfile.server -t pqbio-liboqs .
#   docker run --rm pqbio-liboqs python -m pytest -q
#   docker run --rm pqbio-liboqs python scripts/bench_pqc.py --out /tmp/pqc_micro_liboqs.json
# and check that pqbio.pqc.kem.KEM_BACKEND / pqbio.pqc.sign.SIG_BACKEND report "liboqs",
# not "*-fallback", inside the container.

FROM python:3.11-slim AS base

# liboqs build dependencies: cmake, ninja, a C toolchain, and git. liboqs-python's own
# installer clones and CMake-builds liboqs itself, pinned to the commit matching the
# liboqs-python wheel version (see the pqc-liboqs extra in pyproject.toml) — see
# https://github.com/open-quantum-safe/liboqs-python.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY pqbio ./pqbio

# dev + the primary PQC backend in one step; the liboqs-python version is pinned in
# pyproject.toml's pqc-liboqs extra (verified against FIPS 203/204 artefact sizes
# during scaffolding — see pqbio/pqc/kem.py and pqbio/pqc/sign.py docstrings).
RUN pip install --no-cache-dir -e ".[dev,pqc-liboqs]"

# Fail the image build rather than silently falling back to the pure-Python reference
# implementation inside a container that has every tool needed to build the real thing.
RUN python -c "import oqs; k = oqs.KeyEncapsulation('ML-KEM-768'); print('liboqs OK:', k.details['name'])"

COPY config ./config
COPY scripts ./scripts
COPY tests ./tests

EXPOSE 8000

CMD ["uvicorn", "pqbio.server.app:app", "--host", "0.0.0.0", "--port", "8000"]
