# Copy to .env and fill in for local development. Never commit .env.

# --- crypto ---
PQBIO_CRYPTO__MODE=pq                # classical | pq

# --- server ---
PQBIO_SERVER__WORKERS=4
PQBIO_SERVER__MAX_CONCURRENCY=64
PQBIO_SERVER__REQUEST_TIMEOUT_S=10

# --- state ---
PQBIO_REDIS_URL=redis://localhost:6379/0
PQBIO_SQLITE_PATH=./data/pqbio.db

# --- logging ---
PQBIO_LOG_LEVEL=INFO
